    show t (some k) * z ⟨some k, m⟩ = β _
    simp only [t, dif_pos hk]
    rw [e, inv_mul_cancel_left₀ (hc _)]
  have P := GlobalTheory.T.log_period_statement K ι Φ y Ψ N j M d τ a b k₀ ca cb hb hj hblk hca hcb hy (BM.F l) z₁ (BM.isFrame l)

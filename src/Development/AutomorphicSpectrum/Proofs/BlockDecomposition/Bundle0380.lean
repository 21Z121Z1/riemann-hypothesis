open Polynomial GroundTheory.BlockD.FourierDecayAlt.GaugeExists in

theorem qdet_eq_sum_coeff {A : Type} [Ring A] [Algebra ℂ A] (n : ℕ) (E : Fin n → Fin n → A) (w : ℂ) :

    simp_rw [GroundTheory.Automorphic.enorm_sq_eq_tsum e (T _)]
    rw [ENNReal.tsum_comm, ← ENNReal.tsum_prod]
    refine tsum_congr fun p => ?_
    rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
  rw [h3]
  exact hs2.tsum_ofReal_lt_top


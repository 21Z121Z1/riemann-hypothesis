        l c hg Y hdom hp hq S M 𝔐 Fl e hR r hr a3 hrS a1 mu hd (GlobalTheory.CompanionTheory.Ar.Cusp.RootNef.nefThreshold_of_gap_one mu r a2 h1 h2)
  have g1 : D.p - 1 < D.p + D.q := by omega
  have g2 : D.p < D.p + D.q := by omega

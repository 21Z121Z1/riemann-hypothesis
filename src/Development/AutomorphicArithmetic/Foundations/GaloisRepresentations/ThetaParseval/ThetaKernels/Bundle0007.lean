  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun F).1 hy
  refine ⟨c 0, c 1, ?_⟩
  rw [← hc, Fin.sum_univ_two]
  simp [Algebra.smul_def]

theorem UpperTheory.TP.K.locUnit_diff {F E : Type} [Field F] [Field E] [CharZero E] [Algebra F E] {σ : E →ₐ[F] E}

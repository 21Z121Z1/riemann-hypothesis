    Algebra.FormallyUnramified.ext_of_iInf w (Ideal.iInf_pow_eq_bot_of_isDomain w hw)
      (fun x => Ideal.Quotient.eq.2 (hcon x))
  have hx : ∀ x : 𝓞 E, σ (x : E) = x := fun x =>

  fun _ _ _ _ _ _ _ _ d Φ hΦ x g => _root_.PositivityTheory.SiegelWeilFormula.tweyl.comm_k d hT g Φ hΦ x
end PositivityTheory.SiegelWeilFormula.tweyl

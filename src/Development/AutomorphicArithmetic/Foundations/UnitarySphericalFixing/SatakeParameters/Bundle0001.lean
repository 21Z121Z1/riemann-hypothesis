theorem locPar_tw (π : CG E a) (χ : CG E 1) (h : IsPlaceOver A w)
    (hg : Good (⟨a, ParLaws.toCl (π.loc w)⟩ : IrrGL (w.adicCompletion E))) :
    ParLaws.locPar hL (π.tw χ) h = (ParLaws.locPar hL π h).lpChar (ParLaws.locPar hL χ h) := by

      rw [← hpar]
      exact UpperTheory.GalS.ncW_of_nc T hm
    have hgood : UpperTheory.Zero.LLC.Good (⟨D.R.r, ParLaws.toCl ((CG.mk π₀).loc w)⟩ : IrrGL (w.adicCompletion D.host.E)) := by
      rw [hmk]

    refine hab.crys σ₀ hσ₀ ((_root_.GlobalTheory.CuspRep.ParLaws.reciprocity_unramified_iff_spherical (_root_.GlobalTheory.CuspRep.ParLawsT.isRecT_locRecT hL (D.nd.plOm.2 w)) (ParLaws.toRep σ₀)).1 ?_)

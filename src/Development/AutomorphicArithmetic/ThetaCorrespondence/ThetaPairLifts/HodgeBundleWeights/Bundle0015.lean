  rw [nval_of_ne hne, nval_of_ne hne', EReal.coe_eq_coe_iff] at hs
  have hr' : (0 : ℝ) < r := by exact_mod_cast hr
  have hφ0 := hφ.nonneg
  rw [Nat.cast_one, div_one] at hs
  rw [← hs, div_le_iff₀ hr']

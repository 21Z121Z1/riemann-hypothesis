  · unfold IsCr Crys IsCrys
    rw [hC, Subgroup.range_subtype, sup_Iq, idx_GK]
  · unfold IsDr DeRham IsDR
    rw [hD, Subgroup.range_subtype, show (GK K).index = finrank ℚ_[l] K.1 from idx_GK K.1]
end


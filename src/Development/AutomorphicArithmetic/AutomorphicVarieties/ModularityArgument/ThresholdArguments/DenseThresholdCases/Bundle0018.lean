  refine Multiset.map_congr rfl fun b _ => ?_
  simp only [Function.comp_apply, Units.val_mul, mul_assoc]
theorem UpperTheory.V.Sd.twist_real_selfDual :
    _root_.UpperTheory.V.Af.Hypotheses' → UpperTheory.V.Sd.TwR := by

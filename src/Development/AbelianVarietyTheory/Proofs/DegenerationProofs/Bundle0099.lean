    rw [hfe z J hJ, SectionScalarValuation.sval_lin (fun i => gF D F (a α i)) (σF α) (fun j => hsum α j) _ z hJ, cst_eq, map_sum,
      Finset.sum_mul, Finset.sum_mul, Finset.sum_mul, Finset.sum_mul]

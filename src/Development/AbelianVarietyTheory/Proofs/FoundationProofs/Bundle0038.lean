    fun i => ((⟨f i, hf i⟩ : B.toAddSubgroup) : B.toAddSubgroup ⧸ _)
  have hφ : Function.Bijective φ := by
    constructor
    · intro i j hij
      have hji : f j - f i ∈ A := (quotient_mk_eq_mk_iff_sub_mem A B _ _).1 hij
      obtain ⟨k, -, hk⟩ := ht (f j) (hf j)
      rw [hk i hji, hk j (by simp)]

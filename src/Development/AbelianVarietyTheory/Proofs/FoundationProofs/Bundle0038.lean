      (y : X) - x ∈ A := by
  rw [QuotientAddGroup.eq, AddSubgroup.mem_addSubgroupOf]
  have : ((-x + y : B.toAddSubgroup) : X) = (y : X) - x := by
    push_cast; abel
  rw [this]; rfl


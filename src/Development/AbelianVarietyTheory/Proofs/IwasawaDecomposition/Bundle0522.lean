    (h : ∀ PP ∈ Pg, ∀ c, ψ' PP c = φ (ψ PP c)) (x : (P0 Pg r ψ).H) (x' : (P0 Pg r ψ').H) (hx : (x : G0 Pg r) = x') :
    (((P0 Pg r ψ').chi x' : LL'ˣ) : LL') = φ (((P0 Pg r ψ).chi x : LLˣ) : LL) := by
  obtain ⟨x, hxm⟩ := x

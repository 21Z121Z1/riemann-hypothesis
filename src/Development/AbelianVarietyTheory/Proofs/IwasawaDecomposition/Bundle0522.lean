  have hi : ∃ i, PP ∈ (B.primes px).vG i := by
    rcases Finset.mem_union.1 hPP with h | h
    · exact ⟨0, h⟩
    · exact ⟨1, h⟩
  obtain ⟨i, hi⟩ := hi
  have hn := hPr.vG_norm i PP hi
  have hp := hPr.g_prime i
  rw [Ideal.absNorm_apply, Submodule.cardQuot_apply] at hn
  rw [← hn] at hp

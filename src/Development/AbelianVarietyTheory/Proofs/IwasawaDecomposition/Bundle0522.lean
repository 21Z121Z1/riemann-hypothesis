  have e2 := hI.weil ⟨PP, hPP⟩ c n hn.symm
  have e3 := hφ (I.Ch.psi0 ⟨PP, hPP⟩ c)
  exact RingHom.injective _ (e1.trans (e2.symm.trans e3.symm))


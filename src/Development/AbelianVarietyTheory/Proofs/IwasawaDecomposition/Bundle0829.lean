  obtain ⟨τ, hτ⟩ := hb.2 τ'.1
  have hm : τ H.rt = H.rt0 := (hg τ).1 (by rw [hτ]; exact ((hU.2.1 k).2 τ'.1).1 τ'.2)
  exact ⟨⟨τ, hm⟩, Subtype.ext hτ⟩


  have hA' : RelAmple t'.G t'.PP.L := hamp R' h hhs t' m'
  exact ⟨t', ee ▸ n', hP', hA', GlobalTheory.T.canonical_trivial_of_relative_ample E H R' t' hP' hA' (polAt_generic _ hinj (ee ▸ n') hgen)⟩


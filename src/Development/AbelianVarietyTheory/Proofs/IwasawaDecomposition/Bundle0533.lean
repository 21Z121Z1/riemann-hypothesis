    (eG' : Formalism.L2.Col.G0 E1 S' r ≃* G0 Pg' r) (he : HEq eG' eG) (g : Formalism.L2.Col.G0 E1 S r) (g' : Formalism.L2.Col.G0 E1 S' r)

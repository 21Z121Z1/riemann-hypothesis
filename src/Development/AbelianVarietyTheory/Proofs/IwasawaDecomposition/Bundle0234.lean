    have e : star (u : Matrix (Fin n) (Fin n) ℂ)ᵀ = (star (u : Matrix (Fin n) (Fin n) ℂ))ᵀ := rfl
    rw [e, ← Matrix.transpose_mul, h, Matrix.transpose_one]⟩


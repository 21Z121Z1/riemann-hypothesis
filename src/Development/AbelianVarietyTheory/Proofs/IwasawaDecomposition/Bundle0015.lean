    exact one_ne_zero this
  obtain ⟨q, hpq, hdvd⟩ := exists_eq_pow_rootMultiplicity_mul_and_not_dvd p hp0 0
  have hq : ∀ t : ℂ, q.eval t ≠ 0 := by
    intro t ht

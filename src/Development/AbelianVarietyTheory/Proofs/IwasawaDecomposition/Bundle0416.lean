  intro _ _ _ _ D G' _ _ Pl0 T A Ks _ _ _ R F X h t _ hG _ _ _ _ c _ Φ hΦ hcont u
  obtain ⟨ψ, hψ⟩ := hcont u
  have hgap := gapGe_of_gapHyp hG X

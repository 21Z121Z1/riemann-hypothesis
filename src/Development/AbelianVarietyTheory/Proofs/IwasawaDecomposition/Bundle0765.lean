    have e2 := he' k hk1 hkr
    rw [heq k hk1 hkr, e1] at e2
    exact (mul_left_cancel₀ (pow_ne_zero (k * (D.R.r - k) / 2) hq0) e2).symm
  exact Multiset.map_injective hfi hmap

end GlobalTheory.FrobSame

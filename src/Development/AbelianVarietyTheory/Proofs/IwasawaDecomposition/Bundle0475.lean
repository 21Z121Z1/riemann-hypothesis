      Bi a j * (iA F E (((qOf P : ℕ) : E) ^ n)⁻¹ * (Am - 1) j l) * Bm l b := by ring
  rw [e2]
  exact intAtA_mul (intAtA_mul (hBi a j) (hA j l)) (hB l b)


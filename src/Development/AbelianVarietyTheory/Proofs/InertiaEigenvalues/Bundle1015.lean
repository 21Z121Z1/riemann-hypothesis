    have h1 := Twist.triv_good (D := D) (A := Circle) (Q := ∅) splitSet_empty
    exact ⟨h1.isOpen, h1.rat, h1.real, h1.split, h1.unram, fun _ h => absurd h (Finset.notMem_empty _)⟩

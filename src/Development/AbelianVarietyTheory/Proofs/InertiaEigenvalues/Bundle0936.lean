    ∃ s : (AE D)ˣ, ∏ PP ∈ S, v PP = ((ξ s : Circle) : ℂ) := by
  classical
  induction S using Finset.induction_on with
  | empty => exact ⟨1, by simp⟩
  | insert a S ha ih =>

  intro E _ _ _ H k k' _ _ _ _ i t t' n m x x' σ N hx ⟨t'', p, g, u, Hm, α, y, W, h₁, h₂, h₃⟩
  have key : ∀ (f : Sp ℂ ⟶ Sp k) (q : SABMap t'' t f), f = spMap σ ≫ spMap i →

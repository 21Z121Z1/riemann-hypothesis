  exact app_injective_of_frames _ (c.he.pullback f)
    ((VBExt.isFrame_sumElim hS c.he c.ht).pullback f)
    (fun j => QCoh.pullback_map_app_pullbackSections f i _ _) inf_le_right

end GlobalTheory.SubPull

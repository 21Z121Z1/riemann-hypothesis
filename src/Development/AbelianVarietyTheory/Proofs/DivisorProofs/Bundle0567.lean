  | zero =>
    intro w hw
    rw [pow_zero, one_mul] at hw
    rw [Units.ext hw]
  | succ a ih =>
    intro w hw
    have e : ((hζ.unit ^ a * v : (Γ(U, ⊤))ˣ) : Γ(U, ⊤)) = ζ.1 ^ a * v := by simp
    rw [defect_mul_prim Q q hqQ U ζ (hζ.unit ^ a * v) w (by rw [hw, e, pow_succ]; ring)]
    exact ih _ e

end GlobalTheory.EtC.RedChern


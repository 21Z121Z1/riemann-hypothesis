    simp only [Function.comp_apply, Int.coe_castAddHom]
    congr 2
    funext j
    rw [CechPic.cls_pull (comb N n).isLB, GenFibreSecs.cls_comb, map_sum]
    refine Finset.sum_congr rfl fun a _ => ?_

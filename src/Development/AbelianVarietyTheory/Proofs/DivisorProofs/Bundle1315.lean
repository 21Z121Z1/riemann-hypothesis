      _ = d * ((X' * A) * B) := by rw [hX'A, Matrix.mul_assoc, Matrix.mul_assoc]
      _ = d * X' := by rw [Matrix.mul_assoc, hAB, Matrix.mul_one]
  · calc P * B = (P * A) * B := by rw [hPA]
      _ = P := by rw [Matrix.mul_assoc, hAB, Matrix.mul_one]

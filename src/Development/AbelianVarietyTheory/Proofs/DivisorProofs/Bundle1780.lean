  first | exact @GlobalTheory.TwoBasesDet.det_vV_add_eq_zero | exact GlobalTheory.TwoBasesDet.det_vV_add_eq_zero | (intros; apply GlobalTheory.TwoBasesDet.det_vV_add_eq_zero <;> assumption)

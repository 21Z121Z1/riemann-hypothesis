        (V := (M.pow n).B.U j ⊓ (M.pow n).B.U j')
        (fun _ hx => ⟨Set.mem_iInter.1 hx.1 PUnit.unit, Set.mem_iInter.1 hx.2 PUnit.unit⟩)

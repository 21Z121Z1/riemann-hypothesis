    rw [VariableChange.mul_def]
    ext
    · simp
    all_goals
      simp only []
      field_simp
      ring
  rw [key, mul_smul]
  exact GlobalTheory.coeff_mem_variableChange V.toSubring h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2 hr hs ht rfl


  set B := ∑ i, (3 * X i ^ 2 + a₄) / (2 * Y i)
  set D := ∑ i, Y i
  set n : ℂ := ((Fintype.card ι : ℕ) : ℂ)
  have key : (⟨u, A / n, B / n, D / n⟩ : VariableChange ℂ) =
      (⟨1, (A - n * r) / (u : ℂ) ^ 2 / n, (B - n * s) / (u : ℂ) / n,

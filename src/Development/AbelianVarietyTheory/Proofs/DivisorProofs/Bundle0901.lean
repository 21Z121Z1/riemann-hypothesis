      pairP lam (fun _ => (1 : Matrix (Fin n) (Fin n) ℂ)) (map σ (bVVfun K lam i)) (map σ (bVVfun K lam j)) := by
  obtain ⟨Q, hQ⟩ := bVVfun_int K lam i

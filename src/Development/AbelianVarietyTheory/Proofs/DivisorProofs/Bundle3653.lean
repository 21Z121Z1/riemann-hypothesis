      rw [Category.assoc, ← hact, ← Category.assoc, Over.comp_left, (hw i a).2, Category.assoc]
    · apply Over.OverMorphism.ext
      rw [← GlobalTheory.LieEtale.ofFn_prod_comp ψ w, ← hvw]

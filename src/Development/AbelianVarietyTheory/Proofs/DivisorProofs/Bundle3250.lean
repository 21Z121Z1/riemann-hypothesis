  intro E _ _ _ H X t p _ _ Q yb π hπ hact ε hε x hx g e v u hvu hue he cf w σ hw hσ o s
  have e₁ : spMap (intO ℂ_[p]).subtype ≫ x = spMap (algebraMap 𝓞_ℂ_[p] ℂ_[p]) ≫ yb := by
    rw [← hx, GlobalTheory.FlatModel.sp_sp, hε]

def jlMap (h : ℕ) : (Fin h ⊕ Fin h → ℤ) →+ (Fin (8 * h) ⊕ Fin (8 * h) → ℤ) where
  toFun a := fun
    | .inl i => if hi : (i : ℕ) < h then a (.inl ⟨i, hi⟩) else 0
    | .inr i => if hi : (i : ℕ) < h then a (.inr ⟨i, hi⟩) else 0
  map_zero' := by

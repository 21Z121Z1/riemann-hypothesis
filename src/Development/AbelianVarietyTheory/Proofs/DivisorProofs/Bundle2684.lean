    set g : V D → ℂ := fun v => ((φ.φ (pick φ.isLB y) (c.e.symm v) : ℝ) : ℂ) with hg
    have hg2 : ContDiffAt ℝ 2 g (c.e y) := Complex.ofRealCLM.contDiff.contDiffAt.comp _ hd
    have hgc : (fun w => (starRingEnd ℂ) (g w)) = g := funext fun w => by simp [g]

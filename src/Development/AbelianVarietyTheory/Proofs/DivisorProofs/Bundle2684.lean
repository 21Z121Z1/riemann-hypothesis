    rw [← ReciprocityTheory.L2DbarEstimates.ChartWirtingerDerivatives.wdb_conj' D l (ReciprocityTheory.L2DbarEstimates.wdb D j g) (c.e y), h1,
      ReciprocityTheory.L2DbarEstimates.comm_wd_wdb g (c.e y) hg2 j l]


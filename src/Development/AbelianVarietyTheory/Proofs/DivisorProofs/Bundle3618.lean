theorem LatTo.trans
    {V₀ : Type} [CommRing V₀] [IsDomain V₀] [IsLocalRing V₀] {ev₀ : X₁.M.Z.presheaf.stalk z₁ →+* V₀}
    {X₀ : Type} [AddCommGroup X₀] {t₀ : X₀ → V₀} {δ₀ : I → X₀ → X₀}

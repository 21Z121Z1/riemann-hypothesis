    (h₁ : 𝔪₀.LatTo 𝔪₁) (h₂ : 𝔪₁.LatTo 𝔪₂) : 𝔪₀.LatTo 𝔪₂ := by
  obtain ⟨K₁, hK₁, hl₁⟩ := h₁

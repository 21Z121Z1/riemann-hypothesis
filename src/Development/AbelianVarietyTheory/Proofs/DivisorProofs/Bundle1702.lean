    simp only [wsum, hP, Submodule.coe_add, Pi.add_apply, map_add, LinearMap.add_apply,
      Finset.sum_add_distrib] at h1
    simp only [wsum, Fin.sum_univ_add, U, V, Fin.append_left, Fin.append_right]

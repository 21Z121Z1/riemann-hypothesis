    (hμ : μ.IsAddHaarMeasure) (h𝓕 : IsAddFundamentalDomain (ratLF F E nS nT) 𝓕 μ) (u : WOF F E nS nT)
    (G : BBF σ JS JT ξ₀ ψ) :
    ∫⁻ w in 𝓕, ‖(rhoBF σ JS JT ξ₀ ψ hψ u G).1 w‖ₑ ^ 2 ∂μ = ∫⁻ w in 𝓕, ‖G.1 w‖ₑ ^ 2 ∂μ := by

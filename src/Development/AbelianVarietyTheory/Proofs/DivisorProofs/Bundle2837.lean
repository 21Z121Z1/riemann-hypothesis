    RatModel k U.toScheme.functionField :=
  letI : Algebra k U.toScheme.functionField :=
    (Spec.preimage (U.toScheme.fromSpecStalk (genericPoint U.toScheme) ≫ U.ι ≫ s)).hom.toAlgebra
  { Z := U.toScheme

          ((Algebra.TensorProduct.includeRight (R := D.host.F) (A := Ainf D.host.F)
            (B := D.host.E)).commutes q).symm
      rw [TensorProduct.neg_tmul, e0]
    rw [e, map_neg, (hθ τ).1]
    rfl
  simp only [htm, Finset.sum_neg_distrib]
  congr 1
  push_cast
  ring

end GlobalTheory.PsiFinRat

  have e : ∀ W f, ed W f = dB W f := fun W f =>
    sub_eq_zero.1 (GlobalTheory.T.vertical_derivation_lifting_principalPolarization_eq_zero k R P ((TrivSqZeroExt.fstHom k k k).toRingHom.comp ρ) A₀ m₀ hm₀ V jj _ _ hv W f)

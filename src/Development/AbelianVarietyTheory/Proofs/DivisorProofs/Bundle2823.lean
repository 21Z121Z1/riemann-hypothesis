    rw [Category.assoc, Category.assoc, Category.assoc, ← MonObj.comp_mul] at k
    exact congrArg CommaMorphism.left k
  exact Over.OverMorphism.ext (S.left.affineCover.hom_ext _ _ fun i => loc _ _)

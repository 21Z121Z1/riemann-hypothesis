  unfold ConjBase ReadInj LatSmallGen SeriesUnitL AtTw AtPts at *
  refine ((Formalism.MainNotions.Closed.and hI hG).and hU).imp fun Fm CH _ h => ?_
  obtain ⟨x0, hx0⟩ := (h.1.1.and h.1.2).and h.2

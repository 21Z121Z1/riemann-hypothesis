  · rw [hDp]
    have key : ∀ (L L' : LB (Y₀ TF.X Z)) (hL : L.IsLB) (hL' : L'.IsLB), L = L' → cls L hL = cls L' hL' := by
      rintro _ _ _ _ rfl; rfl

        (fun g : E ≃ₐ[F] E => (Algebra.TensorProduct.congr (AlgEquiv.refl : A ≃ₐ[A] A) g)) ?_
      intro g h hgh
      ext x
      have := DFunLike.congr_fun hgh ((1 : A) ⊗ₜ[F] x)

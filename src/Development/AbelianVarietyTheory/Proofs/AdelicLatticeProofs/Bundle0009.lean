theorem exists_radius_lattice_translate_norm_le (V : Type) [NormedAddCommGroup V]
    [NormedSpace ℝ V] [FiniteDimensional ℝ V] (L : Submodule ℤ V) [DiscreteTopology L]
    [IsZLattice ℝ L] : ∃ R : ℝ, 0 < R ∧ ∀ y : V, ∃ l : L, ‖y + l‖ ≤ R := by
  classical
  let b := (Module.Free.chooseBasis ℤ L).ofZLatticeBasis ℝ L
  refine ⟨∑ i, ‖b i‖ + 1, by positivity, fun y => ?_⟩
  have hmem : (ZSpan.floor b y : V) ∈ L :=
    ((Module.Free.chooseBasis ℤ L).ofZLatticeBasis_span ℝ).le (ZSpan.floor b y).2
  refine ⟨-⟨_, hmem⟩, ?_⟩
  have h := ZSpan.norm_fract_le b y
  rw [ZSpan.fract_apply] at h
  have e : y + ((-⟨_, hmem⟩ : L) : V) = y - (ZSpan.floor b y : V) := by
    rw [Submodule.coe_neg, sub_eq_add_neg]
  rw [e]
  linarith

theorem exists_smooth_compactSupport_hasSum_lattice_translates :
    ∀ (V : Type) [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V] (L : Submodule ℤ V) [DiscreteTopology L] [IsZLattice ℝ L], ∃ η : V → ℝ, ContDiff ℝ ∞ η ∧ HasCompactSupport η ∧ ∀ y, HasSum (fun l : L => η (y + l)) 1 := by
  intro V _ _ _ L _ _
  classical
  obtain ⟨R, hR, hcov⟩ := exists_radius_lattice_translate_norm_le V L
  let φ : ContDiffBump (0 : V) := ⟨R + 1, R + 2, by linarith, by linarith⟩
  have hrIn : φ.rIn = R + 1 := rfl
  let b := (Module.Free.chooseBasis ℤ L).ofZLatticeBasis ℝ L
  have hspan : Submodule.span ℤ (Set.range b) = L :=
    (Module.Free.chooseBasis ℤ L).ofZLatticeBasis_span ℝ
  have hfin : ∀ (x : V) (r : ℝ), {l : L | ‖x + (l : V)‖ < r}.Finite := by
    intro x r
    have hs := ZSpan.setFinite_inter b (Metric.isBounded_ball (x := -x) (r := r))
    rw [hspan] at hs
    refine (hs.preimage Subtype.val_injective.injOn).subset ?_
    intro l hl
    refine ⟨?_, l.2⟩
    show dist (l : V) (-x) < r
    rw [dist_eq_norm, sub_neg_eq_add, add_comm]
    exact hl
  let S : V → ℝ := fun y => ∑' l : L, φ (y + l)
  have hsupp : ∀ y, (Function.support fun l : L => φ (y + l)).Finite := by
    intro y
    refine (hfin y φ.rOut).subset fun l hl => ?_
    have h : y + (l : V) ∈ Metric.ball (0 : V) φ.rOut := by
      rw [← φ.support_eq]
      exact hl
    simpa [mem_ball_zero_iff] using h
  have hsum : ∀ y, HasSum (fun l : L => φ (y + l)) (S y) :=
    fun y => (summable_of_hasFiniteSupport (hsupp y)).hasSum
  have hper : ∀ y (l₀ : L), S (y + l₀) = S y := by
    intro y l₀
    calc S (y + l₀) = ∑' c : L, φ (y + ((l₀ + c : L) : V)) := by
          simp only [S, Submodule.coe_add, add_assoc]
      _ = S y := (Equiv.addLeft l₀).tsum_eq (fun l : L => φ (y + l))
  have hpos : ∀ y, 0 < S y := by
    intro y
    obtain ⟨l, hl⟩ := hcov y
    have h1 : φ (y + l) = 1 :=
      φ.one_of_mem_closedBall (by rw [mem_closedBall_zero_iff, hrIn]; linarith)
    have h2 := le_hasSum (hsum y) l (fun _ _ => φ.nonneg)
    linarith
  have hS : ContDiff ℝ ∞ S := by
    rw [contDiff_iff_contDiffAt]
    intro x
    let F := (hfin x (φ.rOut + 1)).toFinset
    have heq : S =ᶠ[nhds x] fun y => ∑ l ∈ F, φ (y + l) := by
      filter_upwards [Metric.ball_mem_nhds x one_pos] with y hy
      refine (hsum y).unique (hasSum_sum_of_ne_finset_zero ?_)
      intro l hl
      rw [Set.Finite.mem_toFinset, Set.mem_ofPred_eq, not_lt] at hl
      apply φ.zero_of_le_dist
      rw [dist_zero_right]
      have h2 : ‖x + (l : V)‖ ≤ ‖y + (l : V)‖ + ‖x - y‖ := by
        calc ‖x + (l : V)‖ = ‖(y + (l : V)) + (x - y)‖ := by congr 1; abel
          _ ≤ _ := norm_add_le _ _
      have h3 : ‖x - y‖ < 1 := by
        rw [← dist_eq_norm, dist_comm]
        exact hy
      linarith
    exact (ContDiff.contDiffAt (ContDiff.sum fun l _ =>
      φ.contDiff.comp (contDiff_id.add contDiff_const))).congr_of_eventuallyEq heq
  refine ⟨fun y => φ y / S y, φ.contDiff.div hS fun y => (hpos y).ne', ?_, ?_⟩
  · refine φ.hasCompactSupport.mono fun y hy => ?_
    simp only [Function.mem_support] at hy ⊢
    intro h
    apply hy
    simp [h]
  · intro y
    show HasSum (fun l : L => φ (y + l) / S (y + l)) 1
    simp_rw [hper y]
    rw [← div_self (hpos y).ne']
    exact (hsum y).div_const _

end GlobalTheory
end

-- bundled from Development.AbelianVarietyTheory.Proofs.AdelicLatticeProofs.ExistsSubSqLtOneOfTwoLtOne
section
open NumberField IsDedekindDomain GlobalTheory.QNorm
open scoped WithZero

namespace GlobalTheory.QNorm

theorem exists_sub_sq_mem_of_two_mem (F : Type) [Field F] [NumberField F]
    (v : HeightOneSpectrum (𝓞 F)) (h2 : (2 : 𝓞 F) ∈ v.asIdeal) (a : 𝓞 F) :
    ∃ b : 𝓞 F, a - b ^ 2 ∈ v.asIdeal := by
  haveI : Finite (𝓞 F ⧸ v.asIdeal) := Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
  haveI := v.isPrime
  have h0 : (2 : 𝓞 F ⧸ v.asIdeal) = 0 := by
    have := Ideal.Quotient.eq_zero_iff_mem.2 h2
    rwa [map_ofNat] at this
  have hinj : Function.Injective (fun t : 𝓞 F ⧸ v.asIdeal => t ^ 2) := by
    intro s t hst
    have hst' : s ^ 2 = t ^ 2 := hst
    have : (s - t) ^ 2 = 0 := by
      linear_combination hst' + (t ^ 2 - s * t) * h0
    exact sub_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 this)
  obtain ⟨t, ht⟩ := Finite.surjective_of_injective hinj (Ideal.Quotient.mk v.asIdeal a)
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective t
  refine ⟨b, Ideal.Quotient.eq.1 ?_⟩
  rw [map_pow]
  exact ht.symm

theorem exists_sub_sq_lt_one_of_two_lt_one :
    ∀ (F : Type) [Field F] [NumberField F] (v : HeightOneSpectrum (𝓞 F)),
      Valued.v (2 : v.adicCompletion F) < 1 → ∀ x : v.adicCompletion F, Valued.v x ≤ 1 →
        ∃ y : v.adicCompletion F, Valued.v y ≤ 1 ∧ Valued.v (x - y ^ 2) < 1 := by
  intro F _ _ v h2 x hx
  set φ := algebraMap F (v.adicCompletion F) with hφ
  have hval : ∀ k : F, Valued.v (φ k) = v.valuation F k := fun k =>
    HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v k
  have hmem : ∀ r : 𝓞 F, v.valuation F (algebraMap (𝓞 F) F r) < 1 ↔ r ∈ v.asIdeal :=
    fun r => HeightOneSpectrum.valuation_lt_one_iff_mem v r

  have h2' : (2 : 𝓞 F) ∈ v.asIdeal := by
    rw [← hmem, ← hval, map_ofNat, map_ofNat]
    exact h2

  obtain ⟨k, hk⟩ : ∃ k : F, Valued.v (φ k - x) < 1 := by
    have hU : {y : v.adicCompletion F | Valued.v (y - x) < 1} ∈ nhds x := by
      rw [Valued.mem_nhds]
      refine ⟨1, fun y hy => ?_⟩
      have hy' : Valued.v.restrict (y - x) < Valued.v.restrict 1 := by simpa using hy
      simpa using Valued.v.restrict_lt_iff.mp hy'
    exact (HeightOneSpectrum.denseRange_algebraMap F v).mem_nhds hU
  have hk1 : v.valuation F k ≤ 1 := by
    rw [← hval]
    have e : φ k = (φ k - x) + x := by ring
    rw [e]
    exact (Valuation.map_add _ _ _).trans (max_le hk.le hx)

  obtain ⟨r, hr⟩ : ∃ r : 𝓞 F, v.valuation F (k - algebraMap (𝓞 F) F r) < 1 := by
    obtain ⟨s, m, hs, hsm⟩ : ∃ s m : 𝓞 F, s ∉ v.asIdeal ∧
        k * algebraMap (𝓞 F) F s = algebraMap (𝓞 F) F m := by
      obtain ⟨n, d, h | h⟩ := HeightOneSpectrum.exists_primeCompl_mul_eq_or_mul_eq (K := F) v k
      · exact ⟨d, n, d.2, h⟩
      · refine ⟨n, d, fun hn => d.2 ?_, h⟩
        show (d : 𝓞 F) ∈ v.asIdeal
        rw [← hmem, ← h, map_mul]
        exact (mul_le_of_le_one_left' hk1).trans_lt ((hmem n).2 hn)
    obtain ⟨t, i, hi, hti⟩ := (Ideal.IsPrime.isMaximal v.isPrime v.ne_bot).exists_inv hs
    refine ⟨t * m, ?_⟩
    have hi' : i = 1 - t * s := by rw [← hti]; ring
    have e : k - algebraMap (𝓞 F) F (t * m) = k * algebraMap (𝓞 F) F i := by
      rw [hi', map_mul, ← hsm, map_sub, map_one, map_mul]; ring
    rw [e, map_mul]
    exact (mul_le_of_le_one_left' hk1).trans_lt ((hmem i).2 hi)

  obtain ⟨b, hb⟩ := exists_sub_sq_mem_of_two_mem F v h2' r
  refine ⟨φ (algebraMap (𝓞 F) F b), ?_, ?_⟩
  · rw [hval]
    exact HeightOneSpectrum.valuation_le_one v b
  · have e : x - φ (algebraMap (𝓞 F) F b) ^ 2 =
        -(φ k - x) + (φ (k - algebraMap (𝓞 F) F r) + φ (algebraMap (𝓞 F) F (r - b ^ 2))) := by
      simp only [map_sub, map_pow]; ring
    rw [e]
    refine Valuation.map_add_lt _ (by rwa [Valuation.map_neg]) (Valuation.map_add_lt _ ?_ ?_)
    · rw [hval]; exact hr
    · rw [hval]; exact (hmem _).2 hb

end GlobalTheory.QNorm
end


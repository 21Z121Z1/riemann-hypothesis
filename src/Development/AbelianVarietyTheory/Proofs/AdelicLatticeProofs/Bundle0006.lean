    intro y
    exact ⟨fun h => by have := key _ h; rwa [hcc] at this, key y⟩
  have hcrit : ∀ (P : HeightOneSpectrum (𝓞 E)) (e : AE F E),
      (∀ x : 𝓞 E, x ≠ 0 →
        (x ∈ P.asIdeal ↔ finPart F E (e * incA F E ((x : E)⁻¹)) ∉ intAE F E)) →

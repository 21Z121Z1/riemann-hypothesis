  intro D L hT Gi Gl Kc Yd cX ex W hW hrS u u' f f' B B' hP hP' a₀ a a₀' a' hA hA' z hz hzc k hk he
  have hm : 0 < D.R.m := by unfold Ranks.rS at hrS; omega
  have hfr := (GlobalTheory.Fam.sdY_frames W hW 0 hm).2
  rw [GlobalTheory.ChainOnto.LStab.finE_mem_St_iff_stabLoc D (Yc D 0) (W.Q.Rl.βY 0) ((pk W).ΛY 0) hfr]
  intro v
  by_cases hg : ∃ PP ∈ (pk W).Pg, PP.under (𝓞 D.host.F) = v

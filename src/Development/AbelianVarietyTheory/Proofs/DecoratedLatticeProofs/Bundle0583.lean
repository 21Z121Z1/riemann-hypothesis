  rw [grpOff, congGrp, MonoidHom.mem_ker]
  have h1 := Units.ext_iff.mp ha
  simp only [finHom, Formalism.UG.bc, MonoidHom.comp_apply, Units.coe_map, Units.val_one] at h1
  apply Units.ext

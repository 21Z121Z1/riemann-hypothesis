theorem GlobalTheory.SchwartzIff.isSchwartzBruhat_iff_mem_schwartzA :
    ∀ (D : D7) (θ : InfFam D), IsInfFam θ → ∀ (m n : ℕ) (φ : Mx D m n → ℂ),

    · rw [(hB p).2.1]
      exact tri_trans (tri_adapt_loc Z p g _ _ (gp p) hgF' (hgp p))
        (tri_map (gp p).toLinearMap (hτ p).2)
  choose y hy using hex
  refine ⟨y, ⟨?_, fun p => ⟨_, hy p, ?_⟩⟩, fun p d => ?_⟩
  · rw [hΛ]; exact isLattice_gmap g _ hrow.1.1

        (GlobalTheory.LocOver.Check.over_of_isTermOver _ _ _ (hy p))
    · intro h
      refine ⟨1, fun _ _ => rfl, y p, h, ?_⟩
      rw [GlobalTheory.LocOver.Check.move_one]

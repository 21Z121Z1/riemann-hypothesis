  have hC : PN.NGChain := Formalism.FourierDecayAlt.P.norm_chain
  intro Cg cb Cw cT CT C0 hcb hcT
  obtain ⟨C1, C0n, A, CB, CSt, Cgs, CTs, h1, h2, h3, h4, hA, C'₀, Cl₀, h⟩ := hc Cg cb Cw cT CT C0 hcb hcT

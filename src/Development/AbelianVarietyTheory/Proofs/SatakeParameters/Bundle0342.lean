    unfold IsOddPos; rw [hp, Nat.not_even_iff_odd, Nat.odd_iff]
  unfold zAt zT reM
  by_cases hs : Even s.val
  · have : ¬ IsOddPos (pos.symm (posJ X D pos i ⟨v, s⟩)).2 := fun h' => (ho.1 h') hs
    simp [hs, this]
  · have : IsOddPos (pos.symm (posJ X D pos i ⟨v, s⟩)).2 := ho.2 hs
    simp [hs, this]


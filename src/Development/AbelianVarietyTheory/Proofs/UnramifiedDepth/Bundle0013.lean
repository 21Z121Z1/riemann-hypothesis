private lemma polCoef_taylor {R₀ A : Type} [CommRing R₀] [CommRing A] [Algebra R₀ A] {g : ℕ}
    (a : Fin g → A) (i : Fin g) (ε : A) (hε : ε * ε = 0) (G : MvPolynomial (Fin g) R₀) :
    MvPolynomial.aeval (a + Pi.single i ε) G
      = MvPolynomial.aeval a G + MvPolynomial.aeval a (MvPolynomial.pderiv i G) * ε := by
  induction G using MvPolynomial.induction_on with
  | C r => simp
  | add f h hf hh => simp only [map_add, hf, hh]; ring
  | mul_X f j hf =>
    simp only [map_mul, hf, MvPolynomial.aeval_X, Derivation.leibniz, smul_eq_mul, map_add,
      MvPolynomial.pderiv_X, Pi.add_apply]
    by_cases hij : j = i
    · subst hij
      simp only [Pi.single_eq_same, map_one]
      linear_combination (MvPolynomial.aeval a (MvPolynomial.pderiv j f)) * hε
    · simp only [Pi.single_eq_of_ne hij, map_zero]
      ring

private lemma polCoef_pderiv {R₀ : Type} [CommRing R₀] (p : ℕ) {g N : ℕ}
    (G : MvPolynomial (Fin g) R₀)
    (H : ∀ (S : Type) [CommRing S] [Algebra R₀ S], (p : S) = 0 → ∀ a e : Fin g → S,
      (∀ i, a i ^ N = 0) → (∀ i j, e i * e j = 0) →
      MvPolynomial.aeval (a + e) G = MvPolynomial.aeval a G)
    {A : Type} [CommRing A] [Algebra R₀ A] (hpA : (p : A) = 0) (x : Fin g → A)
    (hx : ∀ j, x j ^ N = 0) (i : Fin g) :
    MvPolynomial.aeval x (MvPolynomial.pderiv i G) = 0 := by
  have hpS : (p : DualNumber A) = 0 := by
    rw [← map_natCast (algebraMap A (DualNumber A)), hpA, map_zero]
  let φ : A →ₐ[R₀] DualNumber A := IsScalarTower.toAlgHom R₀ A (DualNumber A)
  let a : Fin g → DualNumber A := fun j => φ (x j)
  have h1 := H (DualNumber A) hpS a (Pi.single i DualNumber.eps)
    (fun j => by simp only [a]; rw [← map_pow, hx, map_zero])
    (fun j k => by
      by_cases hj : j = i
      · by_cases hk : k = i
        · subst hj; subst hk
          rw [Pi.single_eq_same, DualNumber.eps_mul_eps]
        · rw [Pi.single_eq_of_ne hk, mul_zero]
      · rw [Pi.single_eq_of_ne hj, zero_mul])
  rw [polCoef_taylor a i _ DualNumber.eps_mul_eps] at h1
  have h2 : MvPolynomial.aeval a (MvPolynomial.pderiv i G) * DualNumber.eps = 0 :=
    add_eq_left.mp h1
  have h3 : MvPolynomial.aeval a (MvPolynomial.pderiv i G)
      = φ (MvPolynomial.aeval x (MvPolynomial.pderiv i G)) := by
    rw [MvPolynomial.comp_aeval_apply]
  rw [h3] at h2
  generalize MvPolynomial.aeval x (MvPolynomial.pderiv i G) = y at h2 ⊢
  have := congrArg TrivSqZeroExt.snd h2
  simpa [φ, TrivSqZeroExt.algebraMap_eq_inl] using this

private lemma polCoef_span {R : Type} [CommRing R] {g N : ℕ} (f : MvPolynomial (Fin g) R)
    (hf : f ∈ Ideal.span (Set.range fun j : Fin g => (MvPolynomial.X j : MvPolynomial (Fin g) R) ^ N)) :
    ∀ m : Fin g →₀ ℕ, (∀ i, m i < N) → MvPolynomial.coeff m f = 0 := by
  rw [Ideal.mem_span_range_iff_exists_fun] at hf
  obtain ⟨c, rfl⟩ := hf
  intro m hm
  rw [MvPolynomial.coeff_sum]
  refine Finset.sum_eq_zero fun j _ => ?_
  rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.coeff_mul_monomial', if_neg]
  intro h
  have := h j
  simp only [Finsupp.single_eq_same] at this
  exact absurd (hm j) (not_lt.mpr this)

theorem coeff_dvd_of_aeval_add_sq_zero :
  (∀ {R₀ : Type} [CommRing R₀] (p : ℕ) [Fact p.Prime] (g N : ℕ) (G : MvPolynomial (Fin g) R₀),
    (∀ (S : Type) [CommRing S] [Algebra R₀ S], (p : S) = 0 → ∀ a e : Fin g → S, (∀ i, a i ^ N = 0) → (∀ i j, e i * e j = 0) →
      MvPolynomial.aeval (a + e) G = MvPolynomial.aeval a G) →
    ∀ m : Fin g →₀ ℕ, (∀ i, m i < N) → (∃ i, ¬ p ∣ m i) → ∃ r : R₀, MvPolynomial.coeff m G = p * r) := by
  intro R₀ _ p hp g N G H m hm ⟨i, hi⟩
  let I : Ideal R₀ := Ideal.span {(p : R₀)}
  let R := R₀ ⧸ I
  let J : Ideal (MvPolynomial (Fin g) R) :=
    Ideal.span (Set.range fun j : Fin g => (MvPolynomial.X j : MvPolynomial (Fin g) R) ^ N)
  let A := MvPolynomial (Fin g) R ⧸ J
  have hpR : (p : R) = 0 := by
    have : (Ideal.Quotient.mk I) (p : R₀) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    simpa using this
  have hpA : (p : A) = 0 := by
    rw [← map_natCast (algebraMap R A), hpR, map_zero]
  let x : Fin g → A := fun j => Ideal.Quotient.mk J (MvPolynomial.X j)
  have hx : ∀ j, x j ^ N = 0 := fun j => by
    simp only [x]
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span ⟨j, rfl⟩
  have h4 := polCoef_pderiv p G H hpA x hx i
  have h5 : ∀ f : MvPolynomial (Fin g) R₀, MvPolynomial.aeval x f
      = Ideal.Quotient.mk J (MvPolynomial.map (algebraMap R₀ R) f) := by
    intro f
    induction f using MvPolynomial.induction_on with
    | C r => simp only [MvPolynomial.aeval_C, MvPolynomial.map_C]; rfl
    | add f h hf hh => simp only [map_add, hf, hh]
    | mul_X f j hf => simp only [map_mul, hf, MvPolynomial.aeval_X, MvPolynomial.map_X, x]
  rw [h5, Ideal.Quotient.eq_zero_iff_mem] at h4
  have hpos : 1 ≤ m i := by
    rcases Nat.eq_zero_or_pos (m i) with h | h
    · exact absurd (h ▸ dvd_zero p) hi
    · exact h
  have h6 := polCoef_span _ h4 (m - Finsupp.single i 1)
    (fun j => lt_of_le_of_lt (by simp) (hm j))
  have hle : Finsupp.single i 1 ≤ m := Finsupp.single_le_iff.mpr hpos
  rw [MvPolynomial.coeff_map, MvPolynomial.coeff_pderiv, tsub_add_cancel_of_le hle] at h6
  have h7 : MvPolynomial.coeff m G * (m i : R₀) ∈ I := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have e : (((m - Finsupp.single i 1 : Fin g →₀ ℕ) i : ℕ) : R₀) + 1 = (m i : R₀) := by
      rw [Finsupp.tsub_apply, Finsupp.single_eq_same, Nat.cast_sub hpos]; simp
    rw [e] at h6
    exact h6
  obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp h7
  have hc : IsCoprime (p : R₀) (m i : R₀) :=
    Nat.Coprime.cast ((Nat.Prime.coprime_iff_not_dvd hp.out).mpr hi)
  obtain ⟨u, v, huv⟩ := hc
  exact ⟨u * MvPolynomial.coeff m G + v * s, by
    linear_combination (-MvPolynomial.coeff m G) * huv - v * hs⟩

end GlobalTheory
end

-- bundled from Development.AbelianVarietyTheory.Proofs.UnramifiedDepth.EvBasicNEvalSubCoeffMem
section
noncomputable section

open TensorProduct IsLocalRing Matrix ReciprocityTheory.PGsh ReciprocityTheory.PGsh.Up ReciprocityTheory.PGsh.L2 ReciprocityTheory.PGsh.Be2

namespace GlobalTheory

section

variable {R₀ : Type} [CommRing R₀] {ι : Type} [Fintype ι] [DecidableEq ι]
  {S : Type} [CommRing S] [Algebra R₀ S]

lemma evBasic_tEval_eq_sum (N : ℕ) (f : MvPowerSeries ι R₀) (a : ι → S) :
    tEval N f a = ∑ e ∈ Fintype.piFinset (fun _ : ι => Finset.range N),
      algebraMap R₀ S (MvPowerSeries.coeff (Finsupp.equivFunOnFinite.symm e) f) *
        ∏ i, a i ^ e i := by
  unfold tEval
  refine Finset.sum_bij' (fun e _ => fun i => (e i : ℕ))
    (fun e he => fun i => ⟨e i, Finset.mem_range.mp (Fintype.mem_piFinset.mp he i)⟩) ?_ ?_ ?_ ?_ ?_
  · intro e _
    exact Fintype.mem_piFinset.mpr fun i => Finset.mem_range.mpr (e i).isLt
  · intro e _
    exact Finset.mem_univ _
  · intro e _
    rfl
  · intro e _
    rfl
  · intro e _
    rfl

lemma evBasic_tEval_of_le {N N' : ℕ} (hN : N ≤ N') (f : MvPowerSeries ι R₀) (a : ι → S)
    (ha : ∀ i, a i ^ N = 0) : tEval N f a = tEval N' f a := by
  rw [evBasic_tEval_eq_sum, evBasic_tEval_eq_sum]
  apply Finset.sum_subset
  · intro e he
    rw [Fintype.mem_piFinset] at he ⊢
    exact fun i => Finset.mem_range.mpr (lt_of_lt_of_le (Finset.mem_range.mp (he i)) hN)
  · intro e _ hne
    rw [Fintype.mem_piFinset] at hne
    push Not at hne
    obtain ⟨i, hi⟩ := hne
    rw [Finset.mem_range, not_lt] at hi
    have hz : ∏ j, a j ^ e j = 0 :=
      Finset.prod_eq_zero (Finset.mem_univ i) (by rw [← Nat.sub_add_cancel hi, pow_add, ha i, mul_zero])
    rw [hz, mul_zero]

lemma evBasic_tEval_indep {N N' : ℕ} (f : MvPowerSeries ι R₀) (a : ι → S)
    (ha : ∀ i, a i ^ N = 0) (ha' : ∀ i, a i ^ N' = 0) : tEval N f a = tEval N' f a := by
  rcases le_total N N' with h | h
  · exact evBasic_tEval_of_le h f a ha
  · exact (evBasic_tEval_of_le h f a ha').symm

lemma evBasic_nEval_eq_tEval (f : MvPowerSeries ι R₀) (a : ι → S) (N : ℕ)
    (ha : ∀ i, a i ^ N = 0) : nEval f a = tEval N f a := by
  classical
  unfold nEval
  split_ifs with h
  · exact evBasic_tEval_indep f a (Nat.find_spec h) ha
  · exact absurd ⟨N, ha⟩ h

omit [DecidableEq ι] in

lemma evBasic_exists_pow (a : ι → S) (ha : ∀ i, IsNilpotent (a i)) :
    ∃ N : ℕ, 0 < N ∧ ∀ i, a i ^ N = 0 := by
  have ha' : ∀ i, ∃ m : ℕ, a i ^ m = 0 := ha
  choose n hn using ha'
  refine ⟨(∑ i, n i) + 1, Nat.succ_pos _, fun i => pow_eq_zero_of_le ?_ (hn i)⟩
  exact (Finset.single_le_sum (fun j _ => Nat.zero_le (n j)) (Finset.mem_univ i)).trans (Nat.le_succ _)

lemma evBasic_map_tEval {S' : Type} [CommRing S'] [Algebra R₀ S'] (φ : S →ₐ[R₀] S') (N : ℕ)
    (f : MvPowerSeries ι R₀) (a : ι → S) :
    φ (tEval N f a) = tEval N f (fun i => φ (a i)) := by
  unfold tEval
  simp only [map_sum, map_mul, map_prod, map_pow, AlgHom.commutes]

lemma evBasic_map_nEval {S' : Type} [CommRing S'] [Algebra R₀ S'] (φ : S →ₐ[R₀] S')
    (f : MvPowerSeries ι R₀) (a : ι → S) (ha : ∀ i, IsNilpotent (a i)) :
    φ (nEval f a) = nEval f (fun i => φ (a i)) := by
  obtain ⟨N, -, hN⟩ := evBasic_exists_pow a ha
  have hN' : ∀ i, φ (a i) ^ N = 0 := fun i => by rw [← map_pow, hN i, map_zero]
  rw [evBasic_nEval_eq_tEval f a N hN, evBasic_nEval_eq_tEval f _ N hN', evBasic_map_tEval]

lemma evBasic_nEval_sub_coeff_mem (f : MvPowerSeries ι R₀) (a : ι → S)
    (ha : ∀ i, IsNilpotent (a i)) :
    nEval f a - algebraMap R₀ S (MvPowerSeries.coeff 0 f) ∈ Ideal.span (Set.range a) := by
  obtain ⟨N, hNpos, hN⟩ := evBasic_exists_pow a ha
  rw [evBasic_nEval_eq_tEval f a N hN, evBasic_tEval_eq_sum]
  have h0 : (0 : ι → ℕ) ∈ Fintype.piFinset (fun _ : ι => Finset.range N) :=
    Fintype.mem_piFinset.mpr fun _ => Finset.mem_range.mpr hNpos
  rw [← Finset.add_sum_erase _ _ h0]
  have hc : algebraMap R₀ S (MvPowerSeries.coeff (Finsupp.equivFunOnFinite.symm (0 : ι → ℕ)) f) *
      ∏ i, a i ^ (0 : ι → ℕ) i = algebraMap R₀ S (MvPowerSeries.coeff 0 f) := by
    have hz : Finsupp.equivFunOnFinite.symm (0 : ι → ℕ) = 0 := by
      ext i
      rfl
    simp [hz]
  rw [hc, add_sub_cancel_left]
  refine Ideal.sum_mem _ fun e he => ?_
  obtain ⟨i, hi⟩ : ∃ i, e i ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact Finset.ne_of_mem_erase he (funext hcon)
  refine Ideal.mul_mem_left _ _ ?_
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ i)]
  exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _
    (Ideal.subset_span (Set.mem_range_self i) : a i ∈ Ideal.span (Set.range a)) _ (Nat.pos_of_ne_zero hi))

end

theorem nEval_basic :
  (∀ {R₀ : Type} [CommRing R₀] {ι : Type} [Fintype ι] [DecidableEq ι] (f : MvPowerSeries ι R₀) (S : Type) [CommRing S] [Algebra R₀ S] (a : ι → S),
    (∀ N : ℕ, (∀ i, a i ^ N = 0) → nEval f a = tEval N f a) ∧
    ((∀ i, IsNilpotent (a i)) → (∀ (S' : Type) [CommRing S'] [Algebra R₀ S'] (φ : S →ₐ[R₀] S'), φ (nEval f a) = nEval f (fun i => φ (a i))) ∧
      nEval f a - algebraMap R₀ S (MvPowerSeries.coeff 0 f) ∈ Ideal.span (Set.range a))) := by
  intro R₀ _ ι _ _ f S _ _ a
  exact ⟨fun N hN => evBasic_nEval_eq_tEval f a N hN,
    fun ha => ⟨fun S' _ _ φ => evBasic_map_nEval φ f a ha, evBasic_nEval_sub_coeff_mem f a ha⟩⟩

end GlobalTheory

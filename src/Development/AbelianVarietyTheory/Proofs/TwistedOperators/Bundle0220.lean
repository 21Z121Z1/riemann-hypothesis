    {M : Subgroup (UJ ε)} {Fsp : Submodule ℂ (UJ ε → U)} (ι : Fsp →ₗ[ℂ] V) {F : UJ ε → U} {g : UJ ε}
    (h : restr M F g ∈ Fsp) : stageFun M Fsp ι F g = ι ⟨_, h⟩ := dif_pos h


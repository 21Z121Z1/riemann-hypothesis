def archCo {W : Type} [AddCommGroup W] [Module (AF F) W] {B : W → W → AF F} (d : GlobalTheory.WeilM.Darboux B κ) (w : W) :
    (κ → mixedEmbedding.mixedSpace F) × (κ → mixedEmbedding.mixedSpace F) :=

  have h := (hΦ.int _).1 hm Q
  rw [← GlobalTheory.SplitDetCharacter.algebraMap_norm, hΦ.base] at h
  exact (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).1 h


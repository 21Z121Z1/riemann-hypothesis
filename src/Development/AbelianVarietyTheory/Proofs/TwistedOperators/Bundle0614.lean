        ((Algebra.norm (AF D.host.F) ((x⁻¹ : (AE D)ˣ) : AE D)).2 (Q.under (𝓞 D.host.F)))) = 1 := by
    rw [← map_mul, ← map_mul]
    have : (Algebra.norm (AF D.host.F) (x : AE D)).2 (Q.under (𝓞 D.host.F)) *
        (Algebra.norm (AF D.host.F) ((x⁻¹ : (AE D)ˣ) : AE D)).2 (Q.under (𝓞 D.host.F)) = 1 := by
      have := congrArg (fun a : AF D.host.F => a.2 (Q.under (𝓞 D.host.F))) hn
      exact this

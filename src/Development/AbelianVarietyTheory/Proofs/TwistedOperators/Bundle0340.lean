        convert GlobalTheory.AdelicU.tmul_mem_latLoc (F := F) (v := v) (one_mem _) hx using 1
        funext i; simp [Formalism.UG.inclE]
      | zero =>
        convert (GlobalTheory.AdelicU.latLoc F L v).zero_mem using 1
        funext i; simp
      | add z w _ _ hz hw =>

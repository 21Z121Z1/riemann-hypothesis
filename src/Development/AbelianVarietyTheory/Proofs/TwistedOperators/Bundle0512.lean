theorem isBump_conj_smul {D : D7} {m n : ℕ} (c c' : AE D) (hc : c' * c = 1) (hc' : c * c' = 1) {β : Mx D m n → ℂ} (hβ : IsBump β) :
    IsBump (fun x : Mx D m n => starRingEnd ℂ (β (c • x))) := by

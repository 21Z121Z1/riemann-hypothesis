  obtain ⟨_, w', hw', -⟩ := t.sym
  exact ⟨⟨t, hA, T₀.g,
    smoothOfRelativeDimension_of_fibre R K (algebraMap R K) t.G _ m.φ T₀.t.G.hom T₀.g hA m.cart.1 T₀.dim,
    sym_of_lbIso_neg ⟨w', hw'⟩, ha,
    hK.kTriv_of_generic hA t.PP.isLB ha m.cart T₀.t.PP.isLB i T₀.ktriv⟩, m, rfl⟩

end GlobalTheory.CM

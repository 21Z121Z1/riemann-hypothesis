  refine ⟨f0, f1, ?_⟩
  rw [cycHerbrand_ofMulDistribMulAction hτ] at h1
  have h0 : (Nat.card (TateNegOne (L ≃ₐ[K] L) 𝒪[L]ˣ) : ℚ) ≠ 0 := by
    exact_mod_cast Nat.card_pos.ne'
  exact_mod_cast (div_eq_one_iff_eq h0).mp h1


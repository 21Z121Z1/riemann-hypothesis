open IsLocalRing

def PolyDerivationsDetectSquare.Statement : Prop :=
  ∀ (k : Type) [Field k] (n : ℕ) (p : Ideal (MvPolynomial (Fin n) k)) [p.IsPrime]
    (g : MvPolynomial (Fin n) k), g ∈ p →
      (∀ D : Derivation ℤ (MvPolynomial (Fin n) k) (MvPolynomial (Fin n) k), D g ∈ p) →

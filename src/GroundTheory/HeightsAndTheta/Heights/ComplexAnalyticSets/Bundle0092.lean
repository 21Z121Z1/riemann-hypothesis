-- bundled from GroundTheory.HeightsAndTheta.Heights.ComplexAnalyticSets.PProjectionCoordinateEquation
section
set_option maxSynthPendingDepth 1

namespace GroundTheory.Heights₂.Heights.IndefiniteRowSideFullHecke.ComplexSets

open MvPolynomial Matrix

noncomputable section

theorem aeval_cons_eq_eval₂_finSuccEquiv {k : ℕ} {B : Type*} [CommRing B] [Algebra ℂ B] (b : B)
    (y : Fin k → B) (P : MvPolynomial (Fin (k + 1)) ℂ) :
    aeval (Fin.cons b y : Fin (k + 1) → B) P =
      Polynomial.eval₂ (aeval y).toRingHom b (finSuccEquiv ℂ k P) := by
  induction P using MvPolynomial.induction_on with
  | C a =>
    rw [← algebraMap_eq, AlgHom.commutes, AlgEquiv.commutes, Polynomial.algebraMap_apply,
      Polynomial.eval₂_C]
    exact ((aeval y).commutes a).symm
  | add p q hp hq => simp [hp, hq, Polynomial.eval₂_add]
  | mul_X p i hp =>
    rw [map_mul, map_mul, Polynomial.eval₂_mul, hp]
    congr 1
    cases i using Fin.cases with
    | zero => simp [finSuccEquiv_X_zero]
    | succ i => simp [finSuccEquiv_X_succ]

theorem finSuccEquiv_pderiv_zero {k : ℕ} (P : MvPolynomial (Fin (k + 1)) ℂ) :
    finSuccEquiv ℂ k (pderiv 0 P) = Polynomial.derivative (finSuccEquiv ℂ k P) := by
  induction P using MvPolynomial.induction_on with
  | C a =>
    rw [pderiv_C, map_zero, ← algebraMap_eq, AlgEquiv.commutes, Polynomial.algebraMap_apply,
      Polynomial.derivative_C]
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp =>
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul, hp, map_mul,
      Polynomial.derivative_mul]
    cases i using Fin.cases with
    | zero =>
      simp only [finSuccEquiv_X_zero, pderiv_X_self, map_one, Polynomial.derivative_X]
      ring
    | succ i =>
      simp only [finSuccEquiv_X_succ, pderiv_X, Pi.single_apply, Fin.succ_ne_zero, if_false, map_zero,
        Polynomial.derivative_C]
      ring

theorem algHom_aeval_eq_eval {σ : Type*} {B : Type*} [CommRing B] [Algebra ℂ B] (e : B →ₐ[ℂ] ℂ)
    (v : σ → B) (P : MvPolynomial σ ℂ) : e (aeval v P) = eval (fun i => e (v i)) P := by
  rw [← AlgHom.comp_apply, comp_aeval]
  exact RingHom.congr_fun (coe_aeval_eq_eval _) P

theorem ProjectionCoordinateEquation.proof : ProjectionCoordinateEquation.Statement := by
  intro n k J A O hV hO hOne hcov j
  have := hV.isPrime
  set B := MvPolynomial (Fin n) ℂ ⧸ J
  let π := Ideal.Quotient.mkₐ ℂ J
  let y : Fin k → B := fun i => π (∑ l, C (A i l) * X l)
  let z : B := π (X j)
  let φ : MvPolynomial (Fin k) ℂ →+* B := (aeval y).toRingHom

  have hev : ∀ x ∈ zeroLocus J, ∃ e : B →ₐ[ℂ] ℂ, (∀ i, e (y i) = (A *ᵥ x) i) ∧ e z = x j := by
    intro x hx
    let e : B →ₐ[ℂ] ℂ := Ideal.Quotient.liftₐ J (aeval x) (fun q hq =>
      (RingHom.congr_fun (coe_aeval_eq_eval x) q).trans (hx q hq))
    have he : ∀ q, e (π q) = aeval x q := fun q => rfl
    refine ⟨e, fun i => ?_, ?_⟩
    · rw [he]
      simp [Matrix.mulVec, dotProduct]
    · rw [he, aeval_X]

  have hind : AlgebraicIndependent ℂ y := by
    rw [algebraicIndependent_iff]
    intro F hF
    obtain ⟨y₀, hy₀⟩ := hOne
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hO y₀ hy₀
    refine funext_set (fun i => Metric.ball (y₀ i) ε)
      (fun i => infinite_of_mem_nhds (y₀ i) (Metric.ball_mem_nhds _ hε)) fun v hv => ?_
    have hvO : v ∈ O := hball (by rw [ball_pi _ hε]; exact hv)
    obtain ⟨x, hx, rfl⟩ := hcov v hvO
    obtain ⟨e, hey, -⟩ := hev x hx
    have := algHom_aeval_eq_eval e y F
    rw [hF, map_zero] at this
    simp only [hey] at this
    rw [map_zero, ← this]

  have : Algebra.FiniteType ℂ B := inferInstance
  have htr := GroundTheory.Arith.Abelian.Jacobian.ringKrullDim_eq_trdeg ℂ (A := B)
  rw [hV.dim] at htr
  have hle : Algebra.trdeg ℂ B ≤ k := by
    rw [← Cardinal.toENat_le_natCast]
    exact le_of_eq (by exact_mod_cast htr.symm)
  have hdep : ∀ b : B, ∃ p : Polynomial (MvPolynomial (Fin k) ℂ), p ≠ 0 ∧ p.eval₂ φ b = 0 := by
    intro b
    have hni : ¬ AlgebraicIndependent ℂ (Fin.cons b y : Fin (k + 1) → B) := by
      intro h
      have := h.cardinalMk_le_trdeg.trans hle
      rw [Cardinal.mk_fin, Nat.cast_le] at this
      omega
    rw [algebraicIndependent_iff] at hni
    push Not at hni
    obtain ⟨R, hR, hR0⟩ := hni
    refine ⟨finSuccEquiv ℂ k R, fun h => hR0 ((finSuccEquiv ℂ k).injective (by rw [h, map_zero])), ?_⟩
    rw [← aeval_cons_eq_eval₂_finSuccEquiv, hR]

  have hex : ∃ d, ∃ p : Polynomial (MvPolynomial (Fin k) ℂ), p ≠ 0 ∧ p.natDegree = d ∧ p.eval₂ φ z = 0 := by
    obtain ⟨p, hp, hpz⟩ := hdep z
    exact ⟨_, p, hp, rfl, hpz⟩
  classical
  obtain ⟨P, hP0, hPd, hPz⟩ := Nat.find_spec hex
  have hmin := fun d (hd : d < Nat.find hex) => Nat.find_min hex hd
  have hdeg : P.natDegree ≠ 0 := by
    intro h0
    rw [Polynomial.natDegree_eq_zero] at h0
    obtain ⟨c, rfl⟩ := h0
    rw [Polynomial.eval₂_C] at hPz
    have hc : c = 0 := (algebraicIndependent_iff.mp hind) c hPz
    exact hP0 (by rw [hc, map_zero])
  have hP'0 : Polynomial.derivative P ≠ 0 := fun h =>
    hdeg (Polynomial.derivative_eq_zero.mp h)
  set w := (Polynomial.derivative P).eval₂ φ z with hw
  have hw0 : w ≠ 0 := by
    intro h
    refine hmin _ ?_ ⟨_, hP'0, rfl, h⟩
    rw [← hPd]
    exact Polynomial.natDegree_derivative_lt hdeg

  obtain ⟨r, hr0, hrw⟩ := hdep w
  obtain ⟨q, hrq, hq⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd r hr0 0
  rw [map_zero, sub_zero, Polynomial.X_dvd_iff] at hq
  rw [map_zero, sub_zero] at hrq
  have hqw : q.eval₂ φ w = 0 := by
    rw [hrq, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at hrw
    exact (mul_eq_zero.mp hrw).resolve_left (pow_ne_zero _ hw0)
  rw [← Polynomial.divX_mul_X_add q, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X,
    Polynomial.eval₂_C] at hqw
  refine ⟨(finSuccEquiv ℂ k).symm P, q.coeff 0, hq, fun x hx => ?_, fun x hx hD => ?_⟩
  · obtain ⟨e, hey, hez⟩ := hev x hx
    have h1 := algHom_aeval_eq_eval e (Fin.cons z y : Fin (k + 1) → B) ((finSuccEquiv ℂ k).symm P)
    rw [aeval_cons_eq_eval₂_finSuccEquiv, AlgEquiv.apply_symm_apply] at h1
    have h2 : (fun i => e ((Fin.cons z y : Fin (k + 1) → B) i)) = Fin.cons (x j) (A *ᵥ x) := by
      funext i
      cases i using Fin.cases with
      | zero => simpa using hez
      | succ i => simpa using hey i
    rw [← h2, ← h1]
    exact hPz.symm ▸ map_zero e
  · obtain ⟨e, hey, hez⟩ := hev x hx
    have h1 := algHom_aeval_eq_eval e (Fin.cons z y : Fin (k + 1) → B)
      (pderiv 0 ((finSuccEquiv ℂ k).symm P))
    rw [aeval_cons_eq_eval₂_finSuccEquiv, finSuccEquiv_pderiv_zero, AlgEquiv.apply_symm_apply] at h1
    have h2 : (fun i => e ((Fin.cons z y : Fin (k + 1) → B) i)) = Fin.cons (x j) (A *ᵥ x) := by
      funext i
      cases i using Fin.cases with
      | zero => simpa using hez
      | succ i => simpa using hey i
    rw [← h2, ← h1]
    intro hwx
    change e w = 0 at hwx
    apply hD
    have h3 := algHom_aeval_eq_eval e y (q.coeff 0)
    have h4 : φ (q.coeff 0) = -((q.divX.eval₂ φ w) * w) := eq_neg_of_add_eq_zero_right hqw
    change e (φ (q.coeff 0)) = _ at h3
    rw [h4, map_neg, map_mul, hwx, mul_zero, neg_zero] at h3
    simp only [hey] at h3
    exact h3.symm

end

end GroundTheory.Heights₂.Heights.IndefiniteRowSideFullHecke.ComplexSets
end

-- bundled from GroundTheory.HeightsAndTheta.Heights.ComplexAnalyticSets.PRegLelongMono
section
set_option maxSynthPendingDepth 1

namespace GroundTheory.Heights₂.Heights

open MvPolynomial MeasureTheory Filter Topology Matrix ComplexSets
open scoped ContDiff

noncomputable section

namespace RegLelongMono

variable {n d : ℕ} {J : Ideal (MvPolynomial (Fin n) ℂ)} {A : Matrix (Fin (d + 1)) (Fin n) ℂ}

theorem chartDens_annulus_nonneg (hL : RegLogDensNonneg.Statement) (u : Fin n → ℂ) {ε : ℝ} (hε : 0 < ε)
    (x : Fin n → ℂ) {r s : ℝ} (hr : 0 < r) (y : Fin (d + 1) → ℂ) :
    0 ≤ chartDens J A ((euclBall x s \ euclBall x r).indicator fun _ => 1)
      (vecCons (logReg u ε) fun _ => logDistSq x) y := by
  unfold chartDens sheetSum
  refine finsum_nonneg fun z => finsum_nonneg fun hz => ?_
  split_ifs with h
  · beta_reduce
    by_cases hza : z ∈ euclBall x s \ euclBall x r
    · rw [Set.indicator_of_mem hza, one_mul]
      have := hL n d J A u ε x z h.choose hε (ne_of_mem_euclBall_diff hr hza) h.choose_spec
      rwa [hz.2] at this
    · rw [Set.indicator_of_notMem hza, zero_mul]
  · exact le_rfl

end RegLelongMono

open RegLelongMono in

theorem RegLelongMono.proof (hA : RegLelongAnnulus.Statement) (hL : RegLogDensNonneg.Statement) :
    RegLelongMono.Statement := by
  intro n d J A u ε x r s hJ hdim hAf hε hr hrs
  have heq := hA n d J A u ε x r s hJ hdim hAf hε hr hrs
  have hτ : 0 ≤ ∫ y, chartDens J A ((euclBall x s \ euclBall x r).indicator fun _ => 1)
      (vecCons (logReg u ε) fun _ => logDistSq x) y :=
    integral_nonneg fun y => chartDens_annulus_nonneg hL u hε x hr y
  have hrs0 : 0 ≤ r ^ (2 * d) * s ^ (2 * d) :=
    mul_nonneg (pow_nonneg hr.le _) (pow_nonneg (hr.le.trans hrs) _)
  have := mul_nonneg hrs0 hτ
  linarith

end

end GroundTheory.Heights₂.Heights
end

-- bundled from GroundTheory.HeightsAndTheta.Heights.ComplexAnalyticSets.PSliceBranches
section
set_option maxSynthPendingDepth 1

namespace GroundTheory.Heights₂.Heights

open MvPolynomial Matrix ComplexSets Filter Topology

theorem SliceBranches.proof (hI : IndefiniteRowSideFullHecke.ComplexSets.SliceImmersiveGeneral.Statement)
    (hB : IndefiniteRowSideFullHecke.ComplexSets.BranchProperAtPoint.Statement) (hM : SliceMatricesOpen.Statement)
    (hC : ImplicitCurve.Statement) : SliceBranches.Statement := by
  intro n d J W u p m γ ord hJ hdim hu hW hp hcov hsl hdisj hord U Λ hUo hUd hΛ
  obtain ⟨N₁, hN₁, hcov₁⟩ := hcov
  obtain ⟨V, hV, hVd⟩ := hI n d J W u p m γ hJ hdim hu hW hp hsl
  have hOp : interior (N₁ ∩ V) ∈ 𝓝 p := interior_mem_nhds.2 (inter_mem hN₁ hV)
  obtain ⟨y, hyO, hyW, hyU⟩ := mem_closure_iff_nhds.1 (hUd hp) _ hOp
  obtain ⟨q, ⟨hqO, hqU⟩, hqW, hqs⟩ := mem_closure_iff_nhds.1 (hVd ⟨hyW, (interior_subset hyO).2⟩)
    (interior (N₁ ∩ V) ∩ U) (inter_mem (isOpen_interior.mem_nhds hyO) (hUo.mem_nhds hyU))
  have hqN : N₁ ∈ 𝓝 q := mem_of_superset (mem_interior_iff_mem_nhds.1 hqO) fun x hx => hx.1
  choose s hs hs0 hsq hsinj using hqs
  obtain ⟨hGo, hGne⟩ := hM n d m (fun b => (γ b).toFun) s
    (fun b => (γ b).differentiableOn.differentiableAt (Metric.isOpen_ball.mem_nhds (hs b))) hsinj
  obtain ⟨L, hLG, hLΛ⟩ := (hΛ q ⟨hqW, hqU⟩).inter_open_nonempty _ hGo hGne
  choose r hr φ hφd hφ0 hφ P hP hPφ using fun b =>
    hC n d (γ b).toFun (γ b).radius L (s b) (γ b).differentiableOn (hs b) (hLG b)
  choose ε hεpos hεP using fun b =>
    hB n (d + 1) J u p q m γ hJ hdim hu ⟨N₁, hqN, hcov₁⟩ hdisj b (s b) (hs b) (hsq b) (P b) (hP b)
  have hφ0' : ∀ b, ∀ τ ∈ Metric.ball (0 : Fin 1 → ℂ) (r b), φ b τ 0 = τ 0 := fun b τ hτ => by
    rw [(hφ b τ hτ).2.1, hs0 b, zero_add]
  let c : Fin m → VarBranch (sliceIdeal J L q) 1 q := fun b =>
    { radius := r b
      radius_pos := hr b
      toFun := fun τ => (γ b).toFun (φ b τ)
      differentiableOn := (γ b).differentiableOn.comp (hφd b) fun τ hτ => (hφ b τ hτ).1
      injOn := fun τ hτ τ' hτ' h => by
        have h0 := congrArg (fun t => t 0) ((γ b).injOn (hφ b τ hτ).1 (hφ b τ' hτ').1 h)
        simp only [hφ0' b τ hτ, hφ0' b τ' hτ'] at h0
        funext i
        rwa [Subsingleton.elim i 0]
      map_zero := by simp only [hφ0 b, hsq b]
      mapsTo := fun τ hτ => by
        rw [zeroSet_sliceIdeal]
        exact ⟨(γ b).mapsTo (hφ b τ hτ).1, by rw [Set.mem_ofPred_eq, (hφ b τ hτ).2.2, hsq b]⟩ }
  have himg : ∀ b, (c b).image ⊆ (γ b).image := by
    rintro b _ ⟨τ, hτ, rfl⟩
    exact ⟨φ b τ, (hφ b τ hτ).1, rfl⟩
  refine ⟨q, ⟨hqW, hqU⟩, L, hLΛ, c, ⟨N₁ ∩ ⋂ b, Metric.ball q (ε b),
    inter_mem hqN (iInter_mem.2 fun b => Metric.ball_mem_nhds q (hεpos b)), ?_⟩,
    fun b b' hbb' x hx => hdisj b b' hbb' ⟨himg b hx.1, himg b' hx.2⟩, fun b => ?_⟩
  · rintro x ⟨hxs, hxN, hxε⟩
    rw [zeroSet_sliceIdeal] at hxs
    obtain ⟨b, t, ht, rfl⟩ : ∃ b, ∃ t ∈ Metric.ball 0 (γ b).radius, (γ b).toFun t = x := by
      simpa [VarBranch.image] using hcov₁ ⟨hxs.1, hxN⟩
    obtain ⟨τ, hτ, rfl⟩ := hPφ b t (hεP b t ht (Set.mem_iInter.1 hxε b))
      (by rw [hxs.2, hsq b])
    exact Set.mem_iUnion.2 ⟨b, τ, hτ, rfl⟩
  · obtain ⟨H, hHd, hH0, hHe⟩ := hord b
    refine ⟨fun τ => H (φ b τ), hHd.comp (hφd b) (fun τ hτ => (hφ b τ hτ).1),
      fun τ hτ => hH0 _ (hφ b τ hτ).1, fun τ hτ => ?_⟩
    show linEval u ((γ b).toFun (φ b τ)) = τ 0 ^ ord b * H (φ b τ)
    have h := hHe _ (hφ b τ hτ).1
    rw [hφ0' b τ hτ] at h
    exact h

end GroundTheory.Heights₂.Heights
end


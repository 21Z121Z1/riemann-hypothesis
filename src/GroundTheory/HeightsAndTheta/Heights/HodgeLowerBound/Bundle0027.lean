theorem NbarSemipos.proof (h : NbarChartSemipos.Statement) : NbarSemipos.Statement := by
  intro II Ψ _ _ K _ ι _ Ω _ _ E _ _ D O Lt _ _ _ X B p q hp _
  obtain ⟨c, hc, hX⟩ := h II Ψ K ι Ω E D O Lt X

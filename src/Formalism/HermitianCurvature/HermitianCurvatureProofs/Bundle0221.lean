        (P5.act (Fr.ofWord L₀ st₀ (D.positionted w)).F Ψ e : Q.Fn P.k P.r (Wq →L[ℂ] Wp))
            c (D.castM (by omega) (ιLev P.k P.r (P.r - P.r) g)) =
          (P5.act (Fr.ofWord L st (D.positionted w)).F (fun e' => T (Ψ e')) e :

  have : ∀ᵐ X ∂(m S), X ∈ gramR R σ J₂ ⁻¹' {((S : HermR R σ n) : Matrix (Fin n) (Fin n) (R ⊗[F] E))} ∩ g ⁻¹' (Unt σ R n) :=
    mem_ae_iff.2 h0
